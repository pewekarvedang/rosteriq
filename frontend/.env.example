# ==============================================================================
# RosterIQ Frontend Environment Configuration Template
# Copy this file to .env or set variables in Vercel Project Settings
# ==============================================================================

# Backend API Endpoint
# In Local Dev: uses Vite proxy (/api/v1 -> http://127.0.0.1:8000/api/v1)
# In Vercel Production: set to your deployed Render backend URL or use relative proxy
# VITE_API_BASE_URL=https://rosteriq-backend.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

# Application Title
VITE_APP_TITLE=RosterIQ - Intelligent Workforce Planning & Roster Optimization
