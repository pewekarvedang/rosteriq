# ==============================================================================
# RosterIQ Backend Environment Configuration Template
# Copy this file to .env and customize values for your deployment environment
# ==============================================================================

# Application Meta
APP_NAME=RosterIQ API
APP_ENV=production
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=False
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Database Configuration (Neon PostgreSQL / Render / Local)
# ------------------------------------------------------------------------------
# Neon Cloud PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<ep-pooler-id>.us-east-2.aws.neon.tech/rosteriq?sslmode=require

# Render Managed PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://rosteriq_user:<password>@dpg-xxxxx.frankfurt.render.com/rosteriq

# Local Development PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rosteriq

# Standalone Local SQLite (fallback):
DATABASE_URL=sqlite:///./rosteriq.db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=True

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# Comma-separated list or JSON array of allowed origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://rosteriq.vercel.app,https://rosteriq-app.vercel.app
