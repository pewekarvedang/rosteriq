# Backend (FastAPI + OR-Tools + PostgreSQL)
APP_NAME=RosterIQ API
APP_ENV=production
DEBUG=False
PORT=8000
DATABASE_URL=postgresql+psycopg2://<neon_user>:<neon_password>@<neon_host>/rosteriq?sslmode=require
CORS_ORIGINS=http://localhost:5173,https://rosteriq.vercel.app

# Frontend (React 19 + TypeScript + Vite)
VITE_API_BASE_URL=https://rosteriq-backend.onrender.com/api/v1
